{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level}] [{SourceContext}.{Method}] ({RequestId}): {Message} {NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=host;Port=port;Database=db;Username=user;Password=password"
  },
  "AuthApi": {
    "BaseUrl": "http://localhost/auth-service"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "user",
    "Password": "password"
  }
}
